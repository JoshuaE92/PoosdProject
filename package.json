{
  "name": "colors-tooling",
  "version": "1.0.0",
  "private": true,
  "description": "Lint and test tooling for the COLORS LAMP app (Node runs the linters and Jest, not the app)",
  "license": "MIT",
  "scripts": {
    "lint": "npm run lint:html && npm run lint:css && npm run lint:js",
    "lint:html": "htmlhint \"public/**/*.html\"",
    "lint:css": "stylelint \"public/**/*.css\"",
    "lint:js": "eslint public/js tests",
    "test": "jest",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "htmlhint": "1.9.2",
    "jest": "30.5.2",
    "stylelint": "17.16.0",
    "stylelint-config-standard": "40.0.0"
  }
}
